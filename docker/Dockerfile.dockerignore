# BuildKit reads this file because it is named "<dockerfile-path>.dockerignore".
# It keeps the build context small and, critically, stops a local build/ tree from
# being copied into the image where it would shadow the prebuilt dependencies.

.git
.github
build/
**/build/
**/results/
**/__pycache__/
*.o
*.a
*.so
output.json
.experiment.json

# Large artifacts that are not needed to compile or run experiments
sosp-replication/data/
doc/html/
doc/latex/

# Local editor / OS noise
.DS_Store
.vscode/
.idea/
